# caddy-mon deployment environment.
# Copy to .env and fill in your local paths. .env is gitignored.

# Base directory of your Caddy stack (contains logs/ and certs/ subdirs).
# Example: /home/youruser/stacks/caddy
CADDY_STACK_DIR=/home/youruser/stacks/caddy

# Caddy admin API URL (optional, defaults to http://caddy-proxy:2019).
CADDY_API=http://caddy-proxy:2019

# SQLite database path (optional, defaults to /data/caddy_mon.db in Docker).
# DB_PATH=/data/caddy_mon.db

# Alerting: Telegram Bot (optional)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=-1001234567890

# Alerting: Generic Webhook / Discord / Slack (optional)
# WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional Dashboard Authentication (Basic Auth)
# If set, protects administrative routes while keeping /status public.
# AUTH_USER=admin
# AUTH_PASSWORD=supersecretpassword

# Public Status Page Custom Title (optional, defaults to "Service Status")
# STATUS_TITLE=System Status
